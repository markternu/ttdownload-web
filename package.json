{
  "name": "ttdownload-web",
  "version": "1.0.0",
  "private": true,
  "description": "统一下载管理器 Web 应用：transmission / aria2 / 公开视频URL 三大下载模块 + 统一等待队列 + 加密发布 + 安卓通信 API",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web ci --no-audit --no-fund && npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:only": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser.smoke.mjs",
    "test:all": "npm test && npm run test:browser"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "playwright": "^1.63.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
