# =============================================================================
#  ttdownload-web 配置文件（.env）
#
#  ❓ 忘了「下载原始文件」要用的 6 位数字密码怎么拿？在**服务器上**执行：
#         sudo ./deploy.sh --orig-code
#     它每 15 分钟自动换一次（不需要改本文件、不需要重启）；输对后 15 分钟内不会再问。
#     数字由下面的 ORIGINAL_DL_SECRET 当"种子"算出来，改那个种子 = 立刻换号。
#
#  其它常用命令：
#         sudo ./deploy.sh --status        查看服务状态
#         sudo ./deploy.sh --logs          看最近日志
#         sudo ./deploy.sh --check-deps    依赖体检
#         sudo ./deploy.sh --update        更新代码并重新部署
#
#  ⚠️ 本文件含密码/令牌，权限应为 600。贴给别人前请先删掉敏感值。
# =============================================================================
# ============================================================
# ttdownload-web 环境变量模板（复制为 .env 后按需修改）
# 一键部署脚本会自动生成 .env，一般不需要手工编辑
# ============================================================

# 监听地址与端口（0.0.0.0 表示允许局域网/公网访问）
HOST=0.0.0.0
PORT=8080

# 下载根目录（三大模块、归档区、消费者目录都在它下面）
DOWNLOAD_ROOT=/ttdownload

# 加密密码（必须与 PC 端解密工具一致；老脚本默认值如下）
ENCRYPT_PASSWORD=ec3e458fcde2582e079f19368abc780f

# 磁盘保留空间（字节，默认 10GiB）：任何下载都不得把可用空间吃到这里以下
RESERVE_FREE_BYTES=10737418240

# 最大并发下载数（全局）与各模块并发
MAX_CONCURRENT=0
CONCURRENCY_TRANSMISSION=0
CONCURRENCY_ARIA2=0
CONCURRENCY_WEBVIDEO=0

# 安卓通信 Token（不配置则 Android 接口关闭）
ANDROID_TOKEN=change-me-please

# aria2 JSON-RPC
ARIA2_RPC_HOST=127.0.0.1
ARIA2_RPC_PORT=6800
ARIA2_RPC_SECRET=
ARIA2_BIN=aria2c

# transmission RPC
TRANSMISSION_RPC_HOST=127.0.0.1
TRANSMISSION_RPC_PORT=9091
TRANSMISSION_RPC_USER=
TRANSMISSION_RPC_PASSWORD=

# ---- transmission 反向代理开关（网页「BT 种子下载」页上的开关 / deploy.sh --bt-proxy）----
# 远程服务器只开 22/80/443 时，9091 外网访问不到；开启开关后 nginx 会把
# http://<域名>/transmission/ 反代到下面的目标，关闭则彻底删除该配置。
# 子路径默认 /transmission（transmission WebUI 自带该前缀，改了会 404，一般不要动）
# BT_PROXY_SUBPATH=/transmission
# 反代目标（默认取上面的 TRANSMISSION_RPC_HOST:TRANSMISSION_RPC_PORT）
# BT_PROXY_TARGET=127.0.0.1:9091
# 生成给用户的外部访问地址前缀（反代下默认按 X-Forwarded-* 推断，多级代理时可显式指定）
# PUBLIC_BASE_URL=https://example.com
TRANSMISSION_REMOTE_BIN=transmission-remote

# ---------- BT 下载/扫货/超时策略（transmission） ----------
# ⚠️ 下面这两个目录**必须**是 transmission 自己的（属主 debian-transmission）；
#    改成我们自己的目录会让它下完搬文件时 Permission denied，每个种子都失败。
#    这里也是它们**唯一**的定义处（历史上重复定义过一次，改一处漏一处很容易踩）
BT_DOWNLOAD_DIR=/var/lib/transmission/downloads
TRANSMISSION_INCOMPLETE_DIR=/var/lib/transmission/incomplete
# 交给 transmission 多少小时后第一次判断超时；到点进度 ≤ 该百分比就清理，否则再宽限这么多小时
BT_CHECK_AFTER_HOURS=12
BT_MIN_PROGRESS_PERCENT=60
BT_GRACE_HOURS=6
# 扫货：小于它的小文件合成一个 zip，≥ 它的各自单独走（默认 300MB）
BT_SMALL_FILE_MAX=314572800
# 多视频"挑同类"：相差多少倍算异类 / "最大的太小、小的成堆"的绝对上限 / 至少几个小文件
BT_BIG_RATIO=5
BT_SMALL_CEILING=209715200
BT_MANY_SMALL_COUNT=3
# 后台 worker 周期（毫秒）：扫货 2 分钟 / 超时检查 10 分钟
BT_HARVEST_INTERVAL_MS=120000
BT_EVICT_INTERVAL_MS=600000

# ---------- 已废弃的旧 BT 出清机制（停滞/极慢/挽救）：留着无害，代码已不再使用 ----------
BT_EVICT_ENABLED=1
BT_EVICT_MIN_AGE_HOURS=10
BT_EVICT_SALVAGE_PERCENT=79
BT_EVICT_STALL_MINUTES=30
BT_EVICT_SLOW_KBPS=20
BT_EVICT_SLOW_ETA_HOURS=72
BT_EVICT_CHECK_INTERVAL_MIN=5

# 全站鉴权（必须配置！否则任何人都能直接打开系统）
#   部署脚本会自动生成并打印；也可自己改成好记的账号密码后重启服务
WEB_AUTH_USER=admin
WEB_AUTH_PASSWORD=
# 会话有效期（小时，默认 168 = 7 天）
WEB_SESSION_HOURS=168
# 会话签名密钥（留空则由账号密码派生；想强制所有人重新登录就换一个随机值）
WEB_SESSION_SECRET=

# 日志（调试期建议 debug：会记录外部命令 argv/退出码/stdout 摘要、HTTP 请求、RPC 调用等）
#   error / warn / info / debug / trace；debug 以上会把细节写进 ${DOWNLOAD_ROOT}/state/app.log
LOG_LEVEL=debug
LOG_MAX_MB=20
LOG_KEEP_FILES=5

# ---- 自动获取访客 cookies（无头浏览器）----
# 抖音/TikTok 这类站点的网页接口需要浏览器 JS 挑战生成的「新鲜」签名 cookie
# （__ac_signature / ttwid 等），且几小时就过期 —— 人工导出跟不上，所以由服务器上的
# 无头 chromium 自动获取并按 TTL 续期。0 = 关闭（关闭后这些站点需要手工上传 cookies.txt）。
COOKIE_HARVEST_ENABLED=1
# 哪些站点启用自动获取（逗号分隔；默认只放开实测确实需要且能自动拿到的）
# COOKIE_HARVEST_SITES=douyin,tiktok
# 抓来的 cookies 多久算过期（小时，默认 6）
# COOKIE_HARVEST_TTL_HOURS=6
# 开机预热：服务每次启动都自动抓一次（HTTP 途径的站点抖音/TikTok/B站**即使没到期也换新的**，
# 这样"刚开机就下单"不会先失败一次）。0 = 关闭开机预热。默认 1。
# COOKIE_HARVEST_WARMUP=1
# 定期刷新间隔（分钟，默认 30）：HTTP 途径的站点按这个间隔换新（一次请求、1 秒、不招风控）；
# 需要开无头浏览器的站点（YouTube/Instagram/X）按上面的 TTL 换新，不会没事就开浏览器。
# 0 = 关闭定期刷新（退回"下单时按需获取"）。
# COOKIE_HARVEST_REFRESH_MIN=30
# 开机预热延迟（毫秒，默认 3000）：让启动时的其它初始化先跑完
# COOKIE_HARVEST_WARMUP_DELAY_MS=3000
# 指定 chromium 路径（默认自动探测 /usr/bin/chromium 等）
# CHROMIUM_PATH=/usr/bin/chromium
SCRIPT_RUN_TIMEOUT_SEC=600
# ---- 「下载原始文件」（把加密成品临时解密后下载）----
# 点击文件页的「下载原始文件」要输入一个 **6 位数字密码**，它每 15 分钟自动换一次，
# 输对后 15 分钟内不再询问。数字不是固定值，而是由下面这个**种子**推出来的
# （HMAC-SHA256(种子, 15分钟窗口) → 6 位）—— 所以这里存的是种子，不是密码本身。
# 在服务器上查看当前密码： sudo ./deploy.sh --orig-code
# 留空 = 关闭该功能（按钮会提示未启用）。改这个种子 = 立刻换号。
ORIGINAL_DL_SECRET=

# 维护令牌：上传/执行/删除脚本时校验；不设则回退用 ANDROID_TOKEN；两者都为空则无需令牌（不建议）
MAINTENANCE_TOKEN=

# 外部工具
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
OPENSSL_BIN=openssl
ZIP_BIN=zip
UNZIP_BIN=unzip

# 公开视频（yt-dlp）：cookies 用于会员专享 / 需登录 / 年龄限制的视频
#   cookies.txt 默认路径 DOWNLOAD_ROOT/state/cookies.txt（也可在网页「设置 → 公开视频（yt-dlp）」里上传）
YTDLP_COOKIES_FILE=
# 从浏览器读取 cookies（需服务器上真有该浏览器配置）：chrome/chromium/edge/firefox/brave/opera/vivaldi/safari
YTDLP_COOKIES_FROM_BROWSER=
# 追加到每次 yt-dlp 调用的额外参数（空格分隔），例如走代理：--proxy socks5://127.0.0.1:1080
YTDLP_EXTRA_ARGS=

# 注：BT 的目录与策略变量统一在上面的「BT 下载/扫货/超时策略」一节定义，这里不再重复。

# ============================ 自动更新（自升级）============================
# 开机后会自动去远端拉最新代码；拉不到（重试几次仍失败）就用本地代码继续启动，
# 运行期间按间隔定时检查，有新版本就自动升级（升级前暂停下载，升完自动恢复）。
# 版本号规范见 docs/VERSIONING.md：只有远端 package.json 的版本号比本地**高**才会自动升；
# 版本号没变的新提交不自动装（可在网页「更新」页手动强制安装）。
# 总开关（0 = 关掉自动检查/自动升级；页面上的「检查更新 / 立即更新」仍然可用）
UPDATE_ENABLED=1
# 代码来源：git remote 名（或完整 URL）+ 分支。换源只改这两个。
UPDATE_REMOTE=origin
UPDATE_BRANCH=main
# 定时检查间隔（分钟）；最小 1
UPDATE_INTERVAL_MIN=60
# 开机后延迟多久做第一次检查（秒）——留时间给网络就绪；绝不能挡住服务启动
UPDATE_BOOT_DELAY_SEC=20
# git fetch 超时（秒）
UPDATE_REMOTE_TIMEOUT_SEC=60
# 拉取失败时的开机重试次数与间隔（毫秒）
UPDATE_BOOT_RETRIES=3
UPDATE_BOOT_RETRY_GAP_MS=15000
# 升级完要重启的 systemd 服务名（部署脚本注册的默认就是 ttdownload-web）
UPDATE_SERVICE_NAME=ttdownload-web
